# Copy to .env for local development. Never commit a real .env file.
# No provider is required for CareerPilot to boot. Job sources, LLMs,
# Temporal, and client tokens are added in later milestones.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (Compose Postgres from M0; application usage starts M1) ---
DATABASE__URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot

# --- Security (real auth lands after M0; set a unique value locally) ---
SECURITY__SECRET_KEY=replace-with-a-long-random-value

# --- Job sources (M3+). Provider-neutral: none of these is required. ---
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Temporal (M8+) ---
# TEMPORAL__HOST=localhost:7233
# TEMPORAL__NAMESPACE=default
# TEMPORAL__TASK_QUEUE=careerpilot-task-queue

# --- LLM (M13+). Business logic must not depend on a specific vendor. ---
# LLM__PROVIDER=openrouter
# LLM__API_KEY=
# LLM__DEFAULT_MODEL=
